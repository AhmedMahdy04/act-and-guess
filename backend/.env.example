PORT=4001
BACKEND_PORT=4001
MONGODB_URI=mongodb://localhost:27017/guessgame
FRONTEND_URL=https://your-frontend.vercel.app
FRONTEND_URLS=https://your-frontend.vercel.app,https://your-frontend-git-main.vercel.app

# Development can fall back to memory. Production always requires MongoDB.
REQUIRE_DATABASE=false
# Number of trusted reverse proxy hops. Keep 0 for direct connections.
TRUST_PROXY_HOPS=0

# Set both values for the initial head admin or to migrate the legacy head account.
# After provisioning, manage your password from the dashboard.
HEAD_ADMIN_EMAIL=
HEAD_ADMIN_PASSWORD=
